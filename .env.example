# Copy this file to ".env" and fill in your own values.
# .env is gitignored — never commit real passwords/keys.

# PDF unlock password for each bank's credit card statement. Check one real
# statement email — the bank states its own password rule there (often a
# formula like "first 4 letters of name + DOB in DDMM").
HDFC_PDF_PASSWORD=
ICICI_PDF_PASSWORD=
AXIS_PDF_PASSWORD=

# Savings/current account statement passwords (separate from the card ones
# above -- may follow a different formula, or the bank may change it over
# time). HDFC_ACCOUNT_PDF_PASSWORD_OLD is tried as a fallback if the bank
# changed its password partway through your statement history.
HDFC_ACCOUNT_PDF_PASSWORD=
HDFC_ACCOUNT_PDF_PASSWORD_OLD=
ICICI_ACCOUNT_PDF_PASSWORD=
AXIS_ACCOUNT_PDF_PASSWORD=

# Your own name as it appears in UPI/bank narrations (partial match is fine,
# e.g. "JOHN SMIT" for "JOHN SMITH") -- used to detect transfers between your
# own accounts at different banks so they aren't counted as real spend/income.
ACCOUNT_HOLDER_NAME=

# Your apartment complex/RWA name as it appears in maintenance-fee debits
# (optional -- leave blank to skip this category).
HOUSING_SOCIETY_KEYWORD=

# Optional -- not used by the current regex-based parsers (src/bank_parsers.py,
# src/account_parsers.py). Only needed if you swap statement parsing back to
# an LLM-based approach. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
